+        elif is_enable_op("rope") and self.position_embedding_type == 'deepseek4':
+            rope_theta = args.rope_theta  # compress_ration=1
+            compress_rope_theta = args.compress_rope_theta  # for compress_ratio>1
+
+            # [Add by GTS-AILab]  [feature GTSOps] Cache rotary_pos_emb across steps.
+            # All scalar args.* are constant,so freqs_cis is identical each step. But the original torch.outer+polar
+            # recomputes new tensors, changing data_ptr each time, causing downstream RoPE fusion (gts_custom_op)
+            # to miss its cos/sin cache and redo prep per step. Caching the stacked result by scalar
+            # keys returns the same object, stabilizing data_ptr, so cos/sin cache hits, eliminating
+            # per-step prep (RepeatInterleave/Neg/Stack...), and rotary generation runs only once.
+            # Reuses __init__'s rotary_pos_emb_cache.
+            _rpe_key = (args.rope_head_dim, args.rope_scaling_original_max_position_embeddings,
+                        args.original_seq_len, rope_theta, compress_rope_theta,
+                        args.rope_factor, args.beta_fast, args.beta_slow)
+            rotary_pos_emb = self.rotary_pos_emb_cache.get(_rpe_key)
+            if rotary_pos_emb is None:
+                rotary_pos_emb_comp = self.rotary_pos_emb(
+                    args.rope_head_dim,
+                    args.rope_scaling_original_max_position_embeddings,
+                    args.original_seq_len,
+                    compress_rope_theta,
+                    args.rope_factor,
+                    args.beta_fast,
+                    args.beta_slow,
+                )
+                rotary_pos_emb_no_comp = self.rotary_pos_emb(
+                    args.rope_head_dim,
+                    args.rope_scaling_original_max_position_embeddings,
+                    0,
+                    rope_theta,
+                    args.rope_factor,
+                    args.beta_fast,
+                    args.beta_slow,
+                )
+                rotary_pos_emb = torch.stack((rotary_pos_emb_comp, rotary_pos_emb_no_comp))
+                self.rotary_pos_emb_cache[_rpe_key] = rotary_pos_emb
         elif self.position_embedding_type == 'deepseek4':
             rope_theta = args.rope_theta  # compress_ration=1
             compress_rope_theta = args.compress_rope_theta  # for compress_ratio>1

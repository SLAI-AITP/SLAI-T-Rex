+    # [Add by GTS-AILab] [feature GTSOps] compressor0
+    def fused_overlap_transform_with_sp_cp(self, kv, score, kv_value, score_value):
+        from mindspeed.gts.ops.gts_custom_op import gts_wind_overlap_transform
+        if mpu.get_tensor_and_context_parallel_world_size() <= 1:
+            return gts_wind_overlap_transform(kv, score, self.compress_ratio, self.head_dim, kv_value, score_value)
+
+        kv = kv.transpose(0, 1)  # BSH --> SBH
+        kv = gather_from_sp_cp(kv)
+        kv = kv.transpose(0, 1)  # SBH --> BSH
+        score = score.transpose(0, 1)  # BSH --> SBH
+        score = gather_from_sp_cp(score)
+        score = score.transpose(0, 1)  # SBH --> BSH
+
+        kv_out, score_out = gts_wind_overlap_transform(kv, score, self.compress_ratio, self.head_dim, kv_value, score_value)
+
+        kv_out = kv_out.transpose(0, 1)  # BSH --> SBH
+        kv_out = permute_cp_shard(kv_out, reorder=False)
+        kv_out = kv_out.transpose(0, 1)  # SBH --> BSH
+        score_out = score_out.transpose(0, 1)  # BSH --> SBH
+        score_out = permute_cp_shard(score_out, reorder=False)
+        score_out = score_out.transpose(0, 1)  # SBH --> BSH
+
+        local_len = kv_out.shape[1] // mpu.get_tensor_model_parallel_world_size()
+        rank = mpu.get_tensor_model_parallel_rank()
+        kv_out = kv_out[:, rank * local_len:(rank + 1) * local_len, :]
+        score_out = score_out[:, rank * local_len:(rank + 1) * local_len, :]
+        return kv_out, score_out
+
